#include <stdio.h>

int maiorNumero(int a, int b)
{
    if (a >= b)
        return a;   // se forem iguais, retorna a
    else
        return b;
}

int main()
{
    int x, y;

    printf("Digite dois numeros inteiros: ");
    scanf("%d %d", &x, &y);

    printf("O maior entre %d e %d eh %d\n", x, y, maiorNumero(x, y));

    return 0;
}
