#include <stdio.h>

// Fatorial recursivo (slide 25)
long fatorial(int n)
{
    if (n <= 1)
        return 1;                 // caso base: 0! = 1! = 1
    return n * fatorial(n - 1);   // caso recursivo
}

int main()
{
    int n;

    printf("Digite um numero (>= 0): ");
    scanf("%d", &n);

    if (n < 0)
        printf("Fatorial nao definido para negativos\n");
    else
        printf("%d! = %ld\n", n, fatorial(n));

    return 0;
}
