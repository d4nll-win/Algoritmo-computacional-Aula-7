#include <stdio.h>

#define DIAS 5

float calcularTotal(float vendas[], int qtd)
{
    int i;
    float total = 0;

    for (i = 0; i < qtd; i++)
        total += vendas[i];

    return total;
}

float calcularMedia(float total, int qtdDias)
{
    return total / qtdDias;
}

int contarVendasAcimaDaMedia(float vendas[], int qtd, float media)
{
    int i, contador = 0;

    for (i = 0; i < qtd; i++)
    {
        if (vendas[i] > media)
            contador++;
    }

    return contador;
}

int main()
{
    float vendas[DIAS];
    float total, media;
    int i, acima;

    for (i = 0; i < DIAS; i++)
    {
        printf("Valor das vendas do dia %d: R$ ", i + 1);
        scanf("%f", &vendas[i]);
    }

    total = calcularTotal(vendas, DIAS);
    media = calcularMedia(total, DIAS);
    acima = contarVendasAcimaDaMedia(vendas, DIAS, media);

    printf("\nTotal vendido: R$ %.2f\n", total);
    printf("Media diaria: R$ %.2f\n", media);
    printf("Dias com vendas acima da media: %d\n", acima);

    return 0;
}
