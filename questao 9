#include <stdio.h>

void mostrarTabuada(int n)
{
    int i;

    printf("\nTabuada do %d:\n", n);
    for (i = 1; i <= 10; i++)
        printf("%d x %d = %d\n", n, i, n * i);
}

int main()
{
    int n;

    printf("Digite um numero inteiro: ");
    scanf("%d", &n);

    mostrarTabuada(n);

    return 0;
}
