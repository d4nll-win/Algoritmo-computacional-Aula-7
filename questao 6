#include <stdio.h>

float adicao(float a, float b)        { return a + b; }
float subtracao(float a, float b)     { return a - b; }
float multiplicacao(float a, float b) { return a * b; }
float divisao(float a, float b)       { return a / b; }

int main()
{
    float n1, n2;
    int op;

    printf("Digite o primeiro numero: ");
    scanf("%f", &n1);
    printf("Digite o segundo numero: ");
    scanf("%f", &n2);

    printf("\nEscolha a operacao:\n");
    printf("1 - Adicao\n");
    printf("2 - Subtracao\n");
    printf("3 - Multiplicacao\n");
    printf("4 - Divisao\n");
    printf("Opcao: ");
    scanf("%d", &op);

    switch (op)
    {
        case 1:
            printf("%.2f + %.2f = %.2f\n", n1, n2, adicao(n1, n2));
            break;
        case 2:
            printf("%.2f - %.2f = %.2f\n", n1, n2, subtracao(n1, n2));
            break;
        case 3:
            printf("%.2f * %.2f = %.2f\n", n1, n2, multiplicacao(n1, n2));
            break;
        case 4:
            if (n2 != 0)
                printf("%.2f / %.2f = %.2f\n", n1, n2, divisao(n1, n2));
            else
                printf("Erro: nao eh possivel dividir por zero!\n");
            break;
        default:
            printf("Opcao invalida!\n");
    }

    return 0;
}
