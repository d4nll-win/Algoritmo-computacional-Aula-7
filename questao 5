#include <stdio.h>

int ehPar(int num)
{
    if (num % 2 == 0)
        return 1;
    else
        return 0;
}

int main()
{
    int n;

    printf("Digite um numero inteiro: ");
    scanf("%d", &n);

    if (ehPar(n))
        printf("%d eh par\n", n);
    else
        printf("%d eh impar\n", n);

    return 0;
}
