#include <stdio.h>

#define PRODUTOS 8

int calcularTotalEstoque(int estoque[], int qtd)
{
    int i, total = 0;

    for (i = 0; i < qtd; i++)
        total += estoque[i];

    return total;
}

int contarEstoqueBaixo(int estoque[], int qtd)
{
    int i, contador = 0;

    for (i = 0; i < qtd; i++)
    {
        if (estoque[i] < 5)
            contador++;
    }

    return contador;
}

// Codigos de 1 a 8 -> indices de 0 a 7. Retorna a posicao ou -1 se o codigo nao existir.
int buscarProduto(int estoque[], int qtd, int codigo)
{
    if (codigo >= 1 && codigo <= qtd)
        return codigo - 1;
    else
        return -1;
}

int main()
{
    int estoque[PRODUTOS];
    int i, codigo, pos;

    for (i = 0; i < PRODUTOS; i++)
    {
        printf("Quantidade do produto %d: ", i + 1);
        scanf("%d", &estoque[i]);
    }

    printf("\nTotal em estoque: %d unidade(s)\n", calcularTotalEstoque(estoque, PRODUTOS));
    printf("Produtos com estoque baixo (menos de 5): %d\n", contarEstoqueBaixo(estoque, PRODUTOS));

    printf("\nDigite o codigo do produto (1 a 8): ");
    scanf("%d", &codigo);

    pos = buscarProduto(estoque, PRODUTOS, codigo);
    if (pos == -1)
        printf("Produto %d nao encontrado!\n", codigo);
    else
        printf("Produto %d esta na posicao %d do vetor, com %d unidade(s)\n", codigo, pos, estoque[pos]);

    return 0;
}
